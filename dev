#!/usr/bin/env bash
# crocket's developer entry point. `./dev help` lists the commands.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$ROOT"

APT_PACKAGES=(g++-16 cmake ninja-build ccache lld libssl-dev zlib1g-dev perl pkg-config
              git curl openssl gdb inotify-tools nghttp2-client
              make m4 bzip2 gpgv)   # the last line is for ./dev gcc
GCC_VERSION=16.2.0
WATCH_DIRS=(include src examples tests CMakeLists.txt)

if [[ -t 2 ]]; then B=$'\e[1m' BLUE=$'\e[1;34m' RED=$'\e[1;31m' GREEN=$'\e[1;32m' R=$'\e[0m'
else B='' BLUE='' RED='' GREEN='' R=''; fi
say()  { printf '%s==>%s %s\n' "$BLUE" "$R" "$*" >&2; }
ok()   { printf '%s==>%s %s\n' "$GREEN" "$R" "$*" >&2; }
warn() { printf '%s==>%s %s\n' "$RED" "$R" "$*" >&2; }
die()  { warn "$*"; exit 1; }

usage() {
  cat <<EOF
${B}./dev${R} <command> [args]

  setup                     Install the toolchain with apt (asks for sudo once)
  gcc                       Build GCC ${GCC_VERSION} into ~/.local (the distro g++-16 is a
                            pre-release snapshot that miscompiles crocket's reflection)
  build [target...]         Build the dev tree (build-dev/, -O0 -g, ccache, lld)
  run <target> [-- args]    Build a target and run it with CROCKET_PROFILE=dev
  watch <target> [-- args]  Run, then rebuild and restart on every save; a failed
                            build leaves the running server alone
  test [ctest args]         Build the dev tree and run ctest in it
  check                     Release tree (build/, -O2) plus the full ctest: run
                            this before calling a change done
  clean [dev|release|all]   Delete build trees (default: dev)
  bench [options] [load|micro] [scenario...]
                            Benchmarks on the release tree: load (h2load against
                            crocket_bench over http/1.1 and h2c) and micro (in-process
                            timings and allocations). Both by default. Options:
                              --save NAME     keep the results as bench/results/NAME.tsv
                              --compare NAME  show the change from NAME; exits 1 if
                                              anything is more than 10% worse
                              --duration S    seconds per load run (default 10)
                              --clients N     connections per load run (default 64)
                              --threads N     h2load threads (default 8, 4 or 2 by cores)
                              --vs-rocket     also run Rocket 0.5 (bench/rocket) on the
                                              same scenarios over HTTP/1.1; needs cargo
                            Numbers compare only on the same machine. h2load comes from
                            nghttp2-client (./dev setup); $H2LOAD overrides the path.
  h2o-update [ref]          Pin h2o to the newest master commit (or a branch, tag
                            or commit), then run ./dev check

<target> is a CMake target; 'hello' and 'serve' are short for crocket_hello and
crocket_serve. Examples:  ./dev watch hello     ./dev test -R compile_fail
EOF
}

# ---- toolchain ---------------------------------------------------------------

cmd_setup() {
  if ((EUID != 0)); then exec sudo "$ROOT/dev" setup; fi
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${APT_PACKAGES[@]}"
  echo
  g++-16 --version | head -1
  cmake --version | head -1
  printf 'ninja %s, ccache %s, %s\n' "$(ninja --version)" \
    "$(ccache --version | head -1 | awk '{print $3}')" "$(ld.lld --version | head -1)"
}

cmd_gcc() {
  local v=$GCC_VERSION src=$HOME/.cache/crocket-gcc
  if [[ -x $GCC_PREFIX/bin/g++-${v%.*} ]]; then ok "GCC $v is already in $GCC_PREFIX"; return; fi
  for t in make m4 bzip2 gpgv curl; do command -v "$t" >/dev/null || die "missing $t; run ./dev setup"; done
  mkdir -p "$src" && cd "$src"
  local url=https://ftp.gnu.org/gnu/gcc/gcc-$v/gcc-$v.tar.xz
  [[ -f gcc-$v.tar.xz ]] || curl -fLO "$url"
  curl -fsSLO "$url.sig"
  curl -fsSL https://ftp.gnu.org/gnu/gnu-keyring.gpg -o gnu-keyring.gpg
  gpgv --keyring ./gnu-keyring.gpg "gcc-$v.tar.xz.sig" "gcc-$v.tar.xz" || die "gcc-$v.tar.xz: bad signature"
  say "unpacking"
  rm -rf "gcc-$v" obj
  tar xf "gcc-$v.tar.xz"
  (cd "gcc-$v" && ./contrib/download_prerequisites)
  mkdir obj && cd obj
  say "building GCC $v into $GCC_PREFIX (15-30 minutes)"
  "../gcc-$v/configure" --prefix="$GCC_PREFIX" --program-suffix="-${v%.*}" \
    --enable-languages=c,c++ --disable-bootstrap --disable-multilib --enable-checking=release \
    CC=gcc-16 CXX=g++-16
  make -j"$(nproc)"
  make install-strip
  cd "$ROOT" && rm -rf "$src/gcc-$v" "$src/obj"
  ok "$("$GCC_PREFIX/bin/g++-${v%.*}" --version | head -1); ./dev uses it from now on"
}

# Compiler: $CROCKET_CC/$CROCKET_CXX, else a GCC 16.2 installed under
# $CROCKET_GCC_PREFIX (default ~/.local/gcc-16.2), else the distro's gcc-16/g++-16.
GCC_PREFIX=${CROCKET_GCC_PREFIX:-$HOME/.local/gcc-${GCC_VERSION%.*}}
if [[ -n ${CROCKET_CXX:-} ]]; then CXX=$CROCKET_CXX CC=${CROCKET_CC:-gcc}
elif [[ -x $GCC_PREFIX/bin/g++-${GCC_VERSION%.*} ]]; then
  CXX=$GCC_PREFIX/bin/g++-${GCC_VERSION%.*} CC=$GCC_PREFIX/bin/gcc-${GCC_VERSION%.*}
else CXX=g++-16 CC=gcc-16; fi

need_tools() {
  local missing=()
  for t in "$CXX" cmake ninja ccache; do command -v "$t" >/dev/null || missing+=("$t"); done
  ((${#missing[@]} == 0)) || die "missing ${missing[*]}; run ./dev setup"
}

# ---- builds ------------------------------------------------------------------

# preset -> build directory (kept in sync with CMakePresets.json)
tree() { [[ $1 == dev ]] && echo "$ROOT/build-dev" || echo "$ROOT/build"; }

configure() { # preset
  local dir; dir=$(tree "$1")
  local cxx; cxx=$(command -v "$CXX")
  # Afterwards, `cmake --build` re-runs configure by itself when CMakeLists change.
  # A different compiler needs a fresh tree.
  local cached; cached=$(sed -n 's/^CMAKE_CXX_COMPILER:[A-Z]*=//p' "$dir/CMakeCache.txt" 2>/dev/null || true)
  if [[ ! -f $dir/build.ninja || $cached != "$cxx" ]]; then
    local args=(--fresh --preset "$1" -DCMAKE_C_COMPILER="$(command -v "$CC")" -DCMAKE_CXX_COMPILER="$cxx")
    # A compiler outside /usr ships a newer libstdc++ than the system's; find it at run time.
    local libdir; libdir=$(dirname "$("$cxx" -print-file-name=libstdc++.so)")
    [[ $libdir == /usr/* ]] || args+=(-DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath,$libdir")
    cmake "${args[@]}" >/dev/null
  fi
  if [[ $1 == dev ]]; then ln -sfn build-dev/compile_commands.json "$ROOT/compile_commands.json"; fi
}

target_name() { # 'hello' -> crocket_hello
  case $1 in hello|serve) echo "crocket_$1" ;; *) echo "$1" ;; esac
}

build() { # preset [target...]
  local preset=$1; shift
  need_tools
  configure "$preset"
  local targets=()
  for t in "$@"; do targets+=(--target "$(target_name "$t")"); done
  cmake --build "$(tree "$preset")" "${targets[@]}"
}

exe_path() { # target -> path of the built executable
  local exe; exe="$(tree dev)/$(target_name "$1")"
  [[ -x $exe ]] || exe=$(find "$(tree dev)" -type f -name "$(target_name "$1")" -perm -u+x | head -1)
  [[ -n $exe && -x $exe ]] || die "no executable for target '$1' in build-dev/"
  echo "$exe"
}

cmd_build() { build dev "$@"; }

cmd_run() {
  (($# >= 1)) || die "usage: ./dev run <target> [-- args]"
  local target=$1; shift
  [[ ${1:-} == -- ]] && shift
  build dev "$target"
  local exe; exe=$(exe_path "$target")
  say "running ${exe#"$ROOT"/} $*"
  CROCKET_PROFILE=dev exec "$exe" "$@"
}

cmd_test() {
  build dev
  ctest --preset dev "$@"
}

cmd_check() {
  build release
  ctest --preset release "$@"
}

cmd_clean() {
  case ${1:-dev} in
    dev)     rm -rf "$ROOT/build-dev" "$ROOT/compile_commands.json" ;;
    release) rm -rf "$ROOT/build" ;;
    all)     rm -rf "$ROOT/build-dev" "$ROOT/build" "$ROOT/compile_commands.json" ;;
    *)       die "usage: ./dev clean [dev|release|all]" ;;
  esac
}

# ---- bench -----------------------------------------------------------------------

BENCH_PORT=18600
ROCKET_BENCH_PORT=18601
# name method path [body]
BENCH_SCENARIOS=(
  "plaintext GET /plaintext"
  "json GET /json"
  "orders POST /orders body"
  "router GET /api/v39/users/7/orders/9"
  "wait GET /wait"
  "wait_async GET /wait_async"
  "plaintext_async GET /async/plaintext"
  "json_async GET /async/json"
  "orders_async POST /async/orders body"
  "router_async GET /async/api/v39/users/7/orders/9"
)

bench_body() { # a 1 KB order for POST /orders
  local items='' i
  for i in 0 1 2 3 4 5 6 7; do
    items+="${items:+,}{\"sku\":\"SKU-$((i * 7919))\",\"name\":\"Widget model $i\",\"qty\":$((i + 1)),\"price\":9.99}"
  done
  printf '{"id":1001,"email":"customer@example.com","tags":["priority","gift","eu"],"items":[%s]}' "$items"
}

# One h2load run -> rows "name.proto<TAB>metric<TAB>value<TAB>better" on stdout.
bench_load_one() { # name method path body proto work port
  local name=$1 method=$2 path=$3 body=$4 proto=$5 work=$6 port=$7
  local args=(-c "$BENCH_CLIENTS" -t "$BENCH_THREADS" -D "$BENCH_DURATION" --warm-up-time 1
              --log-file "$work/$name.$proto.log")
  [[ $proto == h1 ]] && args+=(--h1 -m 1) || args+=(-m 10)
  [[ -n $body ]] && args+=(-d "$work/body.json" -H 'content-type: application/json')
  [[ $method == GET ]] || [[ -n $body ]] || args+=(-H ":method: $method")
  local out; out=$("$H2LOAD" "${args[@]}" "http://127.0.0.1:$port$path" 2>&1) || { warn "$name/$proto: h2load failed"; echo "$out" >&2; return; }
  local rps done ok
  rps=$(sed -n 's/^finished in [^,]*, \([0-9.]*\) req\/s.*/\1/p' <<<"$out")
  read -r done ok < <(sed -n 's/^requests: [0-9]* total, [0-9]* started, \([0-9]*\) done, \([0-9]*\) succeeded.*/\1 \2/p' <<<"$out")
  # Latency percentiles from the per-request log (third column: microseconds).
  local pct; pct=$(cut -f3 "$work/$name.$proto.log" | sort -n | awk '{a[NR]=$1} END {
    if (NR == 0) { print "0 0"; exit }
    p50 = a[int(NR * 0.50) + (NR * 0.50 > int(NR * 0.50))]; p99 = a[int(NR * 0.99) + (NR * 0.99 > int(NR * 0.99))]
    printf "%.3f %.3f", p50 / 1000, p99 / 1000 }')
  local p50 p99; read -r p50 p99 <<<"$pct"
  printf '%s.%s\treq_per_s\t%s\thigher\n' "$name" "$proto" "${rps:-0}"
  printf '%s.%s\tp50_ms\t%s\tlower\n' "$name" "$proto" "$p50"
  printf '%s.%s\tp99_ms\t%s\tlower\n' "$name" "$proto" "$p99"
  printf '%s.%s\tnon_2xx\t%s\tlower\n' "$name" "$proto" "$(( ${done:-0} - ${ok:-0} ))"
  rm -f "$work/$name.$proto.log"
}

bench_wait_up() { # port log name
  local i; for i in $(seq 100); do curl -sf -o /dev/null "http://127.0.0.1:$1/plaintext" && return; sleep 0.1; done
  cat "$2" >&2; die "$3 did not start"
}

# Every chosen scenario against one server -> rows; rows are prefixed with `label`.
bench_scenarios() { # label port work protos [scenario...]
  local label=$1 port=$2 work=$3 protos=$4; shift 4
  local sc name method path body proto
  for sc in "${BENCH_SCENARIOS[@]}"; do
    read -r name method path body <<<"$sc"
    if (($# > 0)) && [[ " $* " != *" $name "* ]]; then continue; fi
    for proto in $protos; do
      say "load: ${label}$name over $proto (${BENCH_DURATION}s, $BENCH_CLIENTS connections)"
      bench_load_one "${label}$name" "$method" "$path" "$body" "$proto" "$work" "$port"
    done
  done
}

bench_load() { # [scenario...] -> rows
  command -v "$H2LOAD" >/dev/null || die "h2load not found; run ./dev setup (nghttp2-client) or set H2LOAD"
  local work; work=$(mktemp -d)
  bench_body >"$work/body.json"
  CROCKET_PORT=$BENCH_PORT "$(tree release)/crocket_bench" >"$work/server.log" 2>&1 &
  local pid=$! rpid=''
  # shellcheck disable=SC2064
  trap "kill $pid \${rpid:-} 2>/dev/null || true; wait $pid \${rpid:-} 2>/dev/null || true; rm -rf '$work'; trap - RETURN" RETURN
  bench_wait_up "$BENCH_PORT" "$work/server.log" crocket_bench
  bench_scenarios "" "$BENCH_PORT" "$work" "h1 h2c" "$@"
  kill "$pid"; wait "$pid" 2>/dev/null || true  # its exit status is not the benchmark's
  if [[ -n $BENCH_VS_ROCKET ]]; then
    # Rocket 0.5 serves HTTP/2 only over TLS, so the comparison is HTTP/1.1.
    ROCKET_PORT=$ROCKET_BENCH_PORT ROCKET_ADDRESS=127.0.0.1 ROCKET_LOG_LEVEL=off \
      "$(tree release)/rocket/release/rocket-bench" >"$work/rocket.log" 2>&1 &
    rpid=$!
    bench_wait_up "$ROCKET_BENCH_PORT" "$work/rocket.log" rocket-bench
    bench_scenarios "rocket:" "$ROCKET_BENCH_PORT" "$work" "h1" "$@"
  fi
}

bench_build_rocket() {
  command -v cargo >/dev/null || die "--vs-rocket needs cargo (a Rust toolchain: https://rustup.rs)"
  say "building bench/rocket (Rocket 0.5, release)"
  cargo build --release --quiet --manifest-path "$ROOT/bench/rocket/Cargo.toml" --target-dir "$(tree release)/rocket" ||
    die "bench/rocket did not build"
}

bench_vs_rocket() { # rows -> a crocket/Rocket table for the HTTP/1.1 scenarios
  awk -F'\t' '
    { v[$1 FS $2] = $3 }
    $1 !~ /^rocket:/ && $1 ~ /\.h1$/ && $2 == "req_per_s" { names[++n] = substr($1, 1, length($1) - 3) }
    END {
      printf "  %-16s %14s %14s %8s   %-17s %-17s\n", "", "crocket req/s", "Rocket req/s", "ratio", "p50 ms (c / R)", "p99 ms (c / R)"
      for (i = 1; i <= n; i++) {
        c = names[i] ".h1"; r = "rocket:" names[i] ".h1"
        if (!((r FS "req_per_s") in v)) continue
        cr = v[c FS "req_per_s"]; rr = v[r FS "req_per_s"]
        printf "  %-16s %14.0f %14.0f %7.2fx   %6.2f / %-8.2f %6.2f / %-8.2f\n", names[i], cr, rr, (rr > 0 ? cr / rr : 0),
               v[c FS "p50_ms"], v[r FS "p50_ms"], v[c FS "p99_ms"], v[r FS "p99_ms"]
      }
    }' "$1"
}

bench_print() { # file
  awk -F'\t' '{ printf "  %-22s %-14s %12s\n", $1, $2, $3 }' "$1"
}

bench_compare() { # baseline current -> table; returns 1 on a >10% regression
  awk -F'\t' -v OFS='\t' '
    NR == FNR { base[$1 FS $2] = $3; next }
    {
      key = $1 FS $2; b = base[key]; c = $3; mark = ""
      if (b == "") { printf "  %-22s %-14s %12s %12s\n", $1, $2, "-", c; next }
      if (b + 0 == 0) change = (c + 0 == 0) ? 0 : 100
      else change = (c - b) / b * 100
      worse = ($4 == "higher") ? -change : change
      # Ignore tiny absolute differences in counts and sub-0.05 ms latencies.
      if (worse > 10 && !(($2 == "non_2xx" || $2 == "allocs_per_op") && c - b < 1) && !($2 ~ /_ms$/ && c - b < 0.05)) { mark = "  WORSE"; bad = 1 }
      else if (worse < -10) mark = "  better"
      printf "  %-22s %-14s %12s %12s %+8.1f%%%s\n", $1, $2, b, c, change, mark
    }
    END { exit bad }' "$1" "$2"
}

cmd_bench() {
  local save='' compare='' kinds=() scenarios=()
  BENCH_VS_ROCKET=
  BENCH_DURATION=10 BENCH_CLIENTS=64
  BENCH_THREADS=$(( $(nproc) >= 16 ? 8 : $(nproc) >= 8 ? 4 : 2 ))
  H2LOAD=${H2LOAD:-h2load}
  while (($#)); do
    case $1 in
      --save) save=$2; shift 2 ;;
      --compare) compare=$2; shift 2 ;;
      --duration) BENCH_DURATION=$2; shift 2 ;;
      --clients) BENCH_CLIENTS=$2; shift 2 ;;
      --vs-rocket) BENCH_VS_ROCKET=1; shift ;;
      --threads) BENCH_THREADS=$2; shift 2 ;;
      load|micro) kinds+=("$1"); shift ;;
      -*) die "unknown option $1" ;;
      *) scenarios+=("$1"); shift ;;
    esac
  done
  ((${#kinds[@]})) || kinds=(load micro)
  if [[ -n $compare && ! -f $ROOT/bench/results/$compare.tsv ]]; then die "no bench/results/$compare.tsv; make one with --save $compare"; fi
  [[ -n $BENCH_VS_ROCKET && " ${kinds[*]} " != *" load "* ]] && die "--vs-rocket compares load runs; drop 'micro'"
  build release crocket_bench crocket_microbench
  [[ -n $BENCH_VS_ROCKET ]] && bench_build_rocket
  local out; out=$(mktemp)
  local k; for k in "${kinds[@]}"; do
    case $k in
      micro) say "micro: in-process timings and allocations"; "$(tree release)/crocket_microbench" >>"$out" ;;
      load) bench_load "${scenarios[@]}" >>"$out" ;;
    esac
  done
  local rc=0
  if [[ -n $BENCH_VS_ROCKET ]]; then
    ok "crocket and Rocket 0.5, HTTP/1.1"
    bench_vs_rocket "$out"
  fi
  if [[ -n $compare ]]; then
    ok "compared with $compare (baseline, now, change)"
    bench_compare "$ROOT/bench/results/$compare.tsv" "$out" || rc=1
    ((rc == 0)) || warn "more than 10% worse on a line marked WORSE"
  else
    ok "results"
    bench_print "$out"
  fi
  if [[ -n $save ]]; then
    mkdir -p "$ROOT/bench/results"
    cp "$out" "$ROOT/bench/results/$save.tsv"
    ok "saved as bench/results/$save.tsv"
  fi
  rm -f "$out"
  return "$rc"
}

# ---- h2o -------------------------------------------------------------------------

H2O_REPO=h2o/h2o
H2O_PIN=$ROOT/cmake/h2o.cmake

# Moves the h2o pin in cmake/h2o.cmake to <ref> (default: master), then runs the
# release build and the full test suite. h2o has no recent release tags, so the
# pin is a commit plus the SHA-256 of its GitHub tarball.
cmd_h2o_update() {
  local ref=${1:-master}
  for t in curl sha256sum sed; do command -v "$t" >/dev/null || die "missing $t"; done
  local old; old=$(sed -n 's/^set(CROCKET_H2O_COMMIT \([0-9a-f]*\)).*/\1/p' "$H2O_PIN")
  [[ -n $old ]] || die "no CROCKET_H2O_COMMIT in ${H2O_PIN#"$ROOT"/}"

  say "resolving h2o '$ref'"
  local json sha date
  json=$(curl -fsSL -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$H2O_REPO/commits/$ref") ||
    die "GitHub has no h2o commit, branch or tag named '$ref'"
  sha=$(sed -n 's/^  "sha": "\([0-9a-f]\{40\}\)",$/\1/p' <<<"$json" | head -1)
  date=$(sed -n 's/^ *"date": "\([0-9-]\{10\}\)T.*/\1/p' <<<"$json" | tail -1)  # committer date
  [[ -n $sha ]] || die "could not read the commit id from GitHub's answer"
  if [[ $sha == "$old" ]]; then ok "h2o is already pinned to $sha ($ref)"; return; fi

  say "downloading h2o $sha ($date)"
  local tmp; tmp=$(mktemp)
  curl -fsSL -o "$tmp" "https://github.com/$H2O_REPO/archive/$sha.tar.gz" || { rm -f "$tmp"; die "download failed"; }
  local sum; sum=$(sha256sum "$tmp" | cut -d' ' -f1)
  rm -f "$tmp"

  sed -i -e "s/^set(CROCKET_H2O_COMMIT [0-9a-f]*).*/set(CROCKET_H2O_COMMIT $sha)  # $date/" \
         -e "s/^set(CROCKET_H2O_SHA256 [0-9a-f]*)/set(CROCKET_H2O_SHA256 $sum)/" "$H2O_PIN"
  ok "pinned h2o $sha ($date) in ${H2O_PIN#"$ROOT"/}"
  say "upstream changes: https://github.com/$H2O_REPO/compare/$old...$sha"
  say "release build and full test suite"
  cmd_check || die "h2o $sha fails ./dev check; the new pin is left in place to investigate (git checkout ${H2O_PIN#"$ROOT"/} reverts it)"
  ok "h2o $sha passes ./dev check; commit ${H2O_PIN#"$ROOT"/} to keep it"
}

# ---- watch -------------------------------------------------------------------

cmd_watch() {
  (($# >= 1)) || die "usage: ./dev watch <target> [-- args]"
  command -v inotifywait >/dev/null || die "inotifywait missing; run ./dev setup"
  local target=$1; shift
  [[ ${1:-} == -- ]] && shift
  local args=("$@") pid='' build_pid=''

  stop_server() {
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
    pid=''
  }
  start_server() {
    local exe; exe=$(exe_path "$target")
    CROCKET_PROFILE=dev "$exe" "${args[@]}" &
    pid=$!
    ok "started ${exe#"$ROOT"/} (pid $pid)"
  }
  rebuild() {
    # In the background, so a signal to ./dev is handled without waiting for the build.
    build dev "$target" & build_pid=$!
    if wait "$build_pid"; then
      stop_server   # graceful: SIGTERM drains in-flight requests first
      start_server
    elif [[ -n $pid ]]; then
      warn "build failed; the previous server is still running"
    else
      warn "build failed; waiting for changes"
    fi
  }

  # One long-lived inotifywait feeds a pipe, so saves made during a build are
  # queued and trigger the next rebuild instead of being missed.
  coproc WATCH { exec inotifywait -mqr -e close_write,moved_to,create,delete --format '%w%f' \
                   "${WATCH_DIRS[@]}"; }
  local watch_pid=$WATCH_PID
  kill_tree() { local c; for c in $(pgrep -P "$1"); do kill_tree "$c"; done; kill "$1" 2>/dev/null || true; }
  trap '[[ -n $build_pid ]] && kill_tree "$build_pid"; stop_server; kill "$watch_pid" 2>/dev/null; exit 0' INT TERM

  rebuild
  say "watching ${WATCH_DIRS[*]} (Ctrl-C to stop)"
  local path
  while read -r path <&"${WATCH[0]}"; do
    case $path in *.cpp|*.hpp|*.h|*.cmake|*CMakeLists.txt|*.sh) ;; *) continue ;; esac
    # Editors often write several files per save; wait until it has been quiet for 200 ms.
    while read -r -t 0.2 path <&"${WATCH[0]}"; do :; done
    if [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null && warn "server exited" || warn "server exited with status $?"
      pid=''
    fi
    say "change detected; rebuilding"
    rebuild
  done
  die "file watcher stopped"
}

# ---- dispatch ----------------------------------------------------------------

cmd=${1:-help}
shift || true
case $cmd in
  setup|gcc|build|run|watch|test|check|clean|bench) "cmd_$cmd" "$@" ;;
  h2o-update) cmd_h2o_update "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
